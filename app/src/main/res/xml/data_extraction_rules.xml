<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="plugins-v1/" />
        <!-- Paired-computer tokens and pinned certificates stay on this device. -->
        <exclude domain="file" path="twilight_core_state/remote_desktops.bin" />
        <exclude domain="file" path="twilight_core_state/remote_desktops.json" />
        <exclude domain="file" path="twilight_core_state/remote_desktop_core.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="plugins-v1/" />
        <exclude domain="file" path="twilight_core_state/remote_desktops.bin" />
        <exclude domain="file" path="twilight_core_state/remote_desktops.json" />
        <exclude domain="file" path="twilight_core_state/remote_desktop_core.json" />
    </device-transfer>
</data-extraction-rules>
